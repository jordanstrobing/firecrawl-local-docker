#!/bin/sh
# Two fixes on top of firecrawl-local, then hand over to it:
# - FIRECRAWL_LOCAL_ALLOWED_HOSTS (comma-separated) becomes --allowed-host
#   flags, because `serve` only takes them as flags.
# - FIRECRAWL_LOCAL_SCROLL of "", 0, false, no or off (any case) means off.
#   The binary turns scrolling on whenever the variable exists at all.
set -eu

case "$(printf '%s' "${FIRECRAWL_LOCAL_SCROLL-unset}" | tr '[:upper:]' '[:lower:]')" in
  "" | 0 | false | no | off) unset FIRECRAWL_LOCAL_SCROLL ;;
esac

if [ "${1:-}" = serve ] && [ -n "${FIRECRAWL_LOCAL_ALLOWED_HOSTS:-}" ]; then
  set -f
  IFS=,
  for host in $FIRECRAWL_LOCAL_ALLOWED_HOSTS; do
    host=$(printf '%s' "$host" | tr -d '[:space:]')
    if [ -n "$host" ]; then
      set -- "$@" --allowed-host "$host"
    fi
  done
  unset IFS
  set +f
fi

exec firecrawl-local "$@"
