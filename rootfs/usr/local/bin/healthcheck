#!/bin/sh
# /health is behind the token check like every other route. The token goes to
# curl on stdin, not as an argument, so it stays off curl's command line.
set -eu

url=http://127.0.0.1:3002/health

if [ -n "${FIRECRAWL_LOCAL_TOKEN:-}" ]; then
  printf 'Authorization: Bearer %s\n' "$FIRECRAWL_LOCAL_TOKEN" \
    | curl -fsS -o /dev/null --max-time 4 -H @- "$url"
else
  curl -fsS -o /dev/null --max-time 4 "$url"
fi
